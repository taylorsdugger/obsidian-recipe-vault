{
  "name": "@recipe-vault/core",
  "version": "0.1.0",
  "description": "Recipe parsing, shopping list math, scaling, nutrition and the note template behind the Recipe Vault Obsidian plugin.",
  "keywords": [
    "recipe",
    "recipes",
    "json-ld",
    "cooklang",
    "shopping-list",
    "obsidian"
  ],
  "author": "Taylor Dugger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorsdugger/obsidian-recipe-vault.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/taylorsdugger/obsidian-recipe-vault/tree/main/packages/core#readme",
  "bugs": "https://github.com/taylorsdugger/obsidian-recipe-vault/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parse/title-words/*.json": "./dist/parse/title-words/*.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "dateformat": "^5.0.3",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@types/dateformat": "^5.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
